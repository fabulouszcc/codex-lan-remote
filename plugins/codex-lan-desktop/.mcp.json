{
  "mcpServers": {
    "phone_connection": {
      "command": "cmd.exe",
      "args": ["/d", "/s", "/c", "call", "./launch.cmd"],
      "cwd": "${PLUGIN_ROOT}",
      "env_vars": ["LOCALAPPDATA", "USERPROFILE", "SystemRoot", "PATH", "TEMP", "TMP", "CODEX_LAN_DATA_DIR", "CODEX_MCP_NODE_PATH"],
      "startup_timeout_sec": 30,
      "tool_timeout_sec": 60
    }
  }
}
